# Local development only. Copy to .env and keep .env out of git.
# Placeholder values — not real credentials.

APP_ENV=local
LOG_LEVEL=INFO

# PostgreSQL. Password below is the local docker-compose default, not a production secret.
DATABASE_URL=postgresql+psycopg://invest:invest@localhost:5432/investment_intelligence

REPORTING_CURRENCY=GBP
SNAPSHOT_INTERVAL_MINUTES=15

# mock: never call an external model.
# gemini: require GEMINI_API_KEY. A missing key is an error. It does not fall back.
# anthropic / openai: use that provider when its key is set, otherwise mock.
# auto: Anthropic, then OpenAI, then Gemini, then mock.
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_MODEL=gpt-4.1-mini
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL=medium

# Reference price table used only to estimate cost. Not an invoice.
COST_REFERENCE_MODEL=claude-sonnet-4-5

# Comma-separated analysis triggers that are allowed to run.
ENABLED_TRIGGERS=MANUAL_DEEP_DIVE,PRE_DECISION_REVIEW,DAILY_CLOSE_REVIEW,LARGE_PRICE_MOVE

# Deterministic risk alert thresholds (fractions, not percents).
CONCENTRATION_TOP1_ALERT=0.25
DRAWDOWN_ALERT=-0.10
CASH_WEIGHT_ALERT=0.05
SCENARIO_IMPACT_ALERT=-0.05

# Seed refuses to run unless the app environment is local.
SEED_ENABLED=true

# mock keeps Today, Positions, and Risk on the seeded portfolio.
# live reads the latest Trading 212 portfolio_snapshot and its position_snapshot rows.
# It does not fall back to mock rows. Restart Streamlit after changing this.
DATA_MODE=mock

# Trading 212 read-only connection. Leave the key and secret blank here.
T212_ENABLED=false
T212_BASE_URL=https://live.trading212.com/api/v0
T212_API_KEY=
T212_API_SECRET=
T212_READ_ONLY=true
T212_POSITION_POLL_SECONDS=30
T212_ACCOUNT_POLL_SECONDS=60
T212_HISTORY_POLL_SECONDS=300
